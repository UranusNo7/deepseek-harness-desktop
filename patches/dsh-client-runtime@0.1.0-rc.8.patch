+                if (stopped)
+                    return;
+                const spec = this._core.specDynamic(key);
+                const epoch = this._core.declarationEpoch(key);
+                if (active !== undefined && activeEpoch === epoch)
+                    return;
+                const dispose = active;
+                active = undefined;
+                activeEpoch = undefined;
+                dispose?.();
+                if (spec === undefined)
+                    return;
