+    includeDescendants?: true;
+    sessionId: import("@deepseek-ai/dsh-session").SessionId;
+}, {
+    sessionId: import("@deepseek-ai/dsh-session").SessionId;
+    includeDescendants?: "true" | "false" | undefined;
+}>>;
